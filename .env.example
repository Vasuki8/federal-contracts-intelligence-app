# Copy to .env and fill in. Never commit .env.
# Both the pipeline (Python) and the web app (Next.js) read this one file.

# --- Database (matches compose.yaml) ---
DATABASE_URL=postgresql://fci:fci@localhost:5432/fci
# Separate database used only by tests (created automatically by docker/postgres/init).
TEST_DATABASE_URL=postgresql://fci:fci@localhost:5432/fci_test

# --- Data sources ---
# SAM.gov API key (needed for the opportunities ingest).
SAM_API_KEY=
# Daily request limit for your SAM.gov key: 10 with no role, 1,000 with a role or as a
# federal user, 10,000 for a federal system account. Jobs stop cleanly at this budget.
SAM_DAILY_REQUEST_LIMIT=10
# Optional: hosted database size limit in MB (Neon free plan: 1024); `app status` warns at 80%.
DATABASE_SIZE_LIMIT_MB=

# --- LLM briefs ---
ANTHROPIC_API_KEY=
# Model name for briefs. Set it here; it is never hard-coded in the app.
ANTHROPIC_MODEL=

# --- Email ---
RESEND_API_KEY=

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Auth ---
# Generate with: openssl rand -base64 32
# Password for the /admin pages (user name: admin) until accounts arrive in M3.
# Leave blank to turn the admin pages off.
ADMIN_PASSWORD=
AUTH_SECRET=

# --- Raw archive ---
# Where raw API responses and bulk files are stored, relative to the repo root.
RAW_ARCHIVE_DIR=./data/raw
